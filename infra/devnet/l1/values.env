# Genesis settings for the local L1, read by ethereum-genesis-generator 6.2.9.
# Every value not set here keeps the generator default. Rationale for each value is in
# docs/design/devnet.md.
export CHAIN_ID="3151908"
export NUMBER_OF_VALIDATORS="64"
export SLOT_DURATION_MS="6000"
export GENESIS_DELAY="30"
# GENESIS_TIMESTAMP is not set here: scripts/devnet/l1-init.sh passes the current time.
