{
  "uid": "settled-chain",
  "title": "settled: chain",
  "description": "The devnet L1 and L2: heads and safety, the verifier, batches, proposals and operator balances.",
  "tags": [
    "settled",
    "devnet"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "L2: blocks and safety",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "L2 heads",
      "description": "Unsafe: built by the sequencer. Safe: derived from batches on the L1. Finalized: its batch is in a finalized L1 block. One line per node and level.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "op_node_default_refs_number{layer=\"l2\",type=~\"l2_unsafe|l2_safe|l2_finalized\"}",
          "legendFormat": "{{node}} {{type}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Blocks behind the unsafe head",
      "description": "How far safe and finalized trail unsafe, per node. Safe trails by about one batch (30 s, 15 blocks); finalized by L1 finality (about 10 minutes, 300 blocks).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "op_node_default_refs_number{layer=\"l2\",type=\"l2_unsafe\"} - ignoring(type) op_node_default_refs_number{layer=\"l2\",type=\"l2_safe\"}",
          "legendFormat": "{{node}} unsafe - safe",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "op_node_default_refs_number{layer=\"l2\",type=\"l2_unsafe\"} - ignoring(type) op_node_default_refs_number{layer=\"l2\",type=\"l2_finalized\"}",
          "legendFormat": "{{node}} unsafe - finalized",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Verifier behind the sequencer",
      "description": "Unsafe head of the sequencer minus the verifier's, in blocks. 0 to 1 is normal; a growing value means the verifier stopped following.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(op_node_default_refs_number{layer=\"l2\",type=\"l2_unsafe\",node=\"sequencer\"}) - max(op_node_default_refs_number{layer=\"l2\",type=\"l2_unsafe\",node=\"verifier\"})",
          "legendFormat": "blocks",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
